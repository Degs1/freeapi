# ==============================================================
# FREEAPI BACKEND ENVIRONMENT VARIABLES
# ==============================================================

# Port Server HTTP (Default: 8000)
PORT=8000

# MongoDB Database Configuration
# Contoh Local URI: mongodb://localhost:27017
# Contoh Atlas URI: mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_NAME=freeapi
