# ==============================================================
# FREEAPI FRONTEND ENVIRONMENT VARIABLES
# ==============================================================
# Variabel yang diawali dengan NEXT_PUBLIC_ dapat diakses
# langsung dari browser (Client Component & Server Component).

# URL Backend Go Gateway
# Local Development: http://localhost:8000
# Production: https://api.namadomainkamu.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Nama Aplikasi (Opsional)
NEXT_PUBLIC_APP_NAME=FreeAPI
