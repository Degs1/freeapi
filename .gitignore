# FreeAPI Root .gitignore

# Dependencies
node_modules/
frontend/node_modules/

# Next.js Build Outputs
frontend/.next/
frontend/out/
frontend/build/

# Go Binaries & Temp
backend/*.exe
backend/temp/*
!backend/temp/.gitkeep
backend/free-api

# Environment variables & secrets (CRITICAL)
*.env
*.env.local
*.env.*.local
!*.env.example

# Logs & Debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Files
.DS_Store
Thumbs.db
desktop.ini
